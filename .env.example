# Cloudinary (envoi des photos). Valeurs publiques : cloud name + preset "unsigned".
VITE_CLOUDINARY_CLOUD=
VITE_CLOUDINARY_PRESET=

# Firebase (config web du projet : console Firebase > Paramètres du projet > Vos applications).
# Ces valeurs ne sont PAS des secrets : elles désignent le projet et sont visibles dans le site construit.
# La sécurité repose sur les règles Firestore et les domaines autorisés (voir README, section Sécurité).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Facultatif : force la date du jour (AAAA-MM-JJ), pour une démonstration ou des tests. Vide = date réelle.
VITE_TODAY=
